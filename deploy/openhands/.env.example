# Copy to .env. This file is shell-compatible and consumed only by run.sh.
# 复制为 .env。该文件兼容 shell，仅由 run.sh 读取。

# Required model settings. Never commit real values.
# 必填模型配置。禁止提交真实值。
LLM_API_KEY=
LLM_MODEL=

# Optional OpenAI-compatible or provider-specific base URL.
# 可选的 OpenAI-compatible 或供应商模型地址。
LLM_BASE_URL=

# Optional existing Obsidian vault. Empty uses an isolated vault under runtime/.
# 可选的现有 Obsidian Vault。留空时使用 runtime/ 下的独立 Vault。
OBSIDIAN_VAULT_PATH=

# Source-tree development only. A distributed bundle already contains Xiaoneng.
# 仅源码树调试使用。正式分发包已经包含小能 bundle。
XIAONENG_SOURCE_PATH=

# Optional runtime overrides.
# 可选运行参数。
OPENHANDS_PORT=8000
OPENHANDS_RUNTIME_ROOT=

# Optional local backend secrets. Agent Canvas generates and persists them when empty.
# 可选本地后端密钥。留空时 Agent Canvas 会生成并持久化。
LOCAL_BACKEND_API_KEY=
OH_SECRET_KEY=
