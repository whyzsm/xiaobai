{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "connector.schema.json",
  "title": "Connector Spec",
  "type": "object",
  "required": ["kind", "id", "capabilities", "permissions", "rateLimit"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "Connector" },
    "id": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "permissions": {
      "type": "object",
      "required": ["write"],
      "additionalProperties": false,
      "properties": {
        "write": {
          "type": "object",
          "required": ["allow", "deny"],
          "additionalProperties": false,
          "properties": {
            "allow": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "deny": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "rateLimit": {
      "type": "object",
      "required": ["maxCallsPerRun"],
      "additionalProperties": false,
      "properties": {
        "maxCallsPerRun": { "type": "integer", "minimum": 1 }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "baseUrl": { "type": "string", "minLength": 1 },
        "server": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "minLength": 1 },
        "searchTool": { "type": "string", "minLength": 1 },
        "getTool": { "type": "string", "minLength": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxLimit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxCharacters": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "scope": { "type": "string", "minLength": 1 },
        "ima": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "server": { "type": "string", "minLength": 1 },
            "tool": { "type": "string", "minLength": 1 },
            "searchTool": { "type": "string", "minLength": 1 },
            "getTool": { "type": "string", "minLength": 1 },
            "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
            "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
            "maxLimit": { "type": "integer", "minimum": 1, "maximum": 100 },
            "maxCharacters": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "scope": { "type": "string", "minLength": 1 }
          },
          "not": {
            "anyOf": [
              { "required": ["credentials"] },
              { "required": ["token"] },
              { "required": ["password"] }
            ]
          }
        }
      },
      "not": {
        "anyOf": [
          { "required": ["credentials"] },
          { "required": ["token"] },
          { "required": ["password"] }
        ]
      }
    },
    "auth": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "tokenEnv": { "type": "string", "minLength": 1 }
      }
    },
    "mock": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
