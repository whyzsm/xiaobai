{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ima-retrieval-evidence.schema.json",
  "title": "IMA Retrieval Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["query", "queryHash", "selectedItemIds", "retrievedAt", "source", "revision", "digest", "scope", "adapterVersion", "status"],
  "properties": {
    "query": { "type": "string", "minLength": 1 },
    "queryHash": { "$ref": "#/$defs/digest" },
    "selectedItemIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "revision": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "digest": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/digest" } },
    "scope": { "type": "string", "minLength": 1 },
    "adapterVersion": { "const": "ima-adapter-v1" },
    "status": { "const": "success" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^(?:sha256:)?[a-f0-9]{64}$" }
  }
}
