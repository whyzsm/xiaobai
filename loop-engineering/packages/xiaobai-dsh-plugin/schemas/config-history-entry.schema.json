{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xiaobai.config/v1/config-history-entry",
  "type": "object",
  "required": ["schemaVersion", "historyId", "revision", "workspaceId", "projectId", "parentRevision", "digest", "operation", "actor", "status", "createdAt", "evidenceRef", "changedFiles", "canRollback"],
  "properties": {
    "schemaVersion": { "const": "xiaobai.config/v1" },
    "historyId": { "type": "string", "pattern": "^ev_[a-z0-9][a-z0-9_-]{2,63}$" },
    "revision": { "type": "string", "pattern": "^rev_[a-z0-9][a-z0-9_-]{2,63}$" },
    "workspaceId": { "type": "string", "pattern": "^ws_[a-z0-9][a-z0-9_-]{2,63}$" },
    "projectId": { "type": "string", "pattern": "^prj_[a-z0-9][a-z0-9_-]{2,63}$" },
    "parentRevision": { "anyOf": [{ "type": "string", "pattern": "^rev_[a-z0-9][a-z0-9_-]{2,63}$" }, { "type": "null" }] },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "operation": { "enum": ["create", "update", "rollback"] },
    "actor": { "type": "string", "minLength": 1 },
    "status": { "enum": ["applied", "failed", "rolled_back"] },
    "createdAt": { "type": "string", "minLength": 1 },
    "evidenceRef": { "type": "string", "minLength": 1 },
    "changedFiles": { "type": "array", "items": { "type": "string" } },
    "canRollback": { "type": "boolean" }
  },
  "additionalProperties": false
}
