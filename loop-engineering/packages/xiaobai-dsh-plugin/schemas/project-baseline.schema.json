{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xiaobai.contracts/v1/project-baseline",
  "title": "ProjectBaseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "key", "displayName", "owner", "classification", "repositories", "knowledgeBindings", "agentProfiles", "skills", "memory", "artifactRoot", "qualityCommands"],
  "properties": {
    "schemaVersion": { "const": "xiaobai.contracts/v1" },
    "projectId": { "type": "string", "pattern": "^prj_[a-z0-9][a-z0-9_-]{2,63}$" },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "displayName": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repoId", "name", "root", "pathTemplate", "source", "readOnly", "owner", "classification", "worktrees"],
        "properties": {
          "repoId": { "type": "string", "pattern": "^repo_[a-z0-9][a-z0-9_-]{2,63}$" },
          "name": { "type": "string", "minLength": 1 },
          "root": { "type": "string", "minLength": 1 },
          "pathTemplate": { "type": "string", "minLength": 1 },
          "source": { "enum": ["local", "remote", "mount"] },
          "readOnly": { "type": "boolean" },
          "owner": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
          "worktrees": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["worktreeId", "root", "pathTemplate", "readOnly", "owner", "classification"],
              "properties": {
                "worktreeId": { "type": "string", "pattern": "^worktree_[a-z0-9][a-z0-9_-]{2,63}$" },
                "root": { "type": "string", "minLength": 1 },
                "pathTemplate": { "type": "string", "minLength": 1 },
                "readOnly": { "type": "boolean" },
                "owner": { "type": "string", "minLength": 1 },
                "classification": { "enum": ["public", "internal", "confidential", "restricted"] }
              }
            }
          }
        }
      }
    },
    "knowledgeBindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "xiaobai.contracts/v1/knowledge-binding" }
    },
    "agentProfiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "xiaobai.contracts/v1/agent-profile" }
    },
    "skills": {
      "type": "array",
      "items": { "$ref": "xiaobai.contracts/v1/skill-package" }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespaceId", "retention", "projection"],
      "properties": {
        "namespaceId": { "type": "string", "pattern": "^mem_[a-z0-9][a-z0-9_-]{2,63}$" },
        "retention": { "type": "string", "minLength": 1 },
        "projection": { "type": "string", "minLength": 1 }
      }
    },
    "artifactRoot": { "type": "string", "minLength": 1 },
    "qualityCommands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validate", "test"],
      "properties": {
        "validate": { "type": "string", "minLength": 1 },
        "test": { "type": "string", "minLength": 1 }
      }
    },
    "policyRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "memory", "workflow"],
      "properties": {
        "agent": { "type": "string", "minLength": 1 },
        "memory": { "type": "string", "minLength": 1 },
        "workflow": { "type": "string", "minLength": 1 }
      }
    },
    "lifecycle": { "enum": ["draft", "active", "blocked", "completed", "archived"] }
  }
}
