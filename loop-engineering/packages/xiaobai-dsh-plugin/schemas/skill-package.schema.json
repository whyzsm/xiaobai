{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xiaobai.contracts/v1/skill-package",
  "title": "SkillPackage",
  "type": "object",
  "additionalProperties": false,
  "required": ["skillId", "name", "version", "purpose", "owner", "invocation", "requiredContext", "capabilities", "sideEffects", "evidenceRequirements", "trust"],
  "properties": {
    "skillId": { "type": "string", "pattern": "^skill_[a-z0-9][a-z0-9_-]{2,63}$" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "version": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelInvocable", "userInvocable"],
      "properties": {
        "modelInvocable": { "type": "boolean" },
        "userInvocable": { "type": "boolean" }
      }
    },
    "requiredContext": { "type": "array", "items": { "type": "string" } },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "sideEffects": { "type": "array", "items": { "type": "string" } },
    "evidenceRequirements": { "type": "array", "items": { "type": "string" } },
    "trust": { "enum": ["bundled", "project", "external"] }
  }
}
