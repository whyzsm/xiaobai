{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xiaobai.contracts/v1/memory-checkpoint",
  "title": "MemoryCheckpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkpointId", "projectId", "namespaceId", "inputDigest", "auditDigest", "sourceRef", "createdAt", "provenance"],
  "properties": {
    "checkpointId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "pattern": "^prj_[a-z0-9][a-z0-9_-]{2,63}$" },
    "namespaceId": { "type": "string", "pattern": "^mem_[a-z0-9][a-z0-9_-]{2,63}$" },
    "inputDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "auditDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceRef": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "minLength": 1 },
    "provenance": { "$ref": "xiaobai.contracts/v1/memory-provenance" }
  }
}
