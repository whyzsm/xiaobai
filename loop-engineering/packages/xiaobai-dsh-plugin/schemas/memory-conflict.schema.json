{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xiaobai.contracts/v1/memory-conflict",
  "title": "MemoryConflict",
  "type": "object",
  "additionalProperties": false,
  "required": ["conflictId", "projectId", "namespaceId", "recordKey", "existingDigest", "incomingDigest", "createdAt", "provenance"],
  "properties": {
    "conflictId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "pattern": "^prj_[a-z0-9][a-z0-9_-]{2,63}$" },
    "namespaceId": { "type": "string", "pattern": "^mem_[a-z0-9][a-z0-9_-]{2,63}$" },
    "recordKey": { "type": "string", "minLength": 1 },
    "existingDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "incomingDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "createdAt": { "type": "string", "minLength": 1 },
    "provenance": { "$ref": "xiaobai.contracts/v1/memory-provenance" }
  }
}
