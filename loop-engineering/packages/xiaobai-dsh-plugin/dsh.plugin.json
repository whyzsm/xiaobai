{
  "name": "@xiaobai/dsh-plugin",
  "version": "0.1.0",
  "description": "Xiaobai Loop Engineering domain providers for DeepSeek Harness",
  "manifestVersion": 1,
  "hostSupport": {
    "dsh": "0.1.0-rc.6",
    "cordis": "4.0.1"
  },
  "capabilities": [
    "project-baseline",
    "project-scope",
    "knowledge-lock",
    "memory-domain",
    "memory-provenance",
    "memory-retention",
    "memory-conflict",
    "memory-projection",
    "workspace-registry",
    "loop-catalog",
    "monitor-projection",
    "fixed-workflow",
    "independent-evaluator",
    "approval-gate",
    "workspace-config-console"
  ],
  "commands": [
    "project-bootstrap",
    "project-assess",
    "project-run",
    "project-load",
    "project-list",
    "loop-list",
    "loop-assess",
    "loop-plan",
    "loop-run",
    "workspace-config-list",
    "workspace-config-get",
    "workspace-config-create-draft",
    "workspace-config-validate",
    "workspace-config-preview",
    "workspace-config-pick-directory",
    "workspace-config-request-approval",
    "workspace-config-apply",
    "workspace-config-history",
    "workspace-config-rollback"
  ],
  "schemas": [
    "ProjectId",
    "KnowledgeBinding",
    "ProjectBaseline",
    "RunLock",
    "AgentProfile",
    "SkillPackage",
    "StageEvidence",
    "MemoryProvenance",
    "MemoryRecord",
    "MemoryCheckpoint",
    "MemoryAudit",
    "MemoryProjection",
    "MemoryConflict",
    "PolicyContext",
    "EvaluatorResult",
    "GateDecision",
    "MonitorProjection",
    "ProjectConfigDraft",
    "ProjectConfigPreview",
    "ProjectConfigApplyResult",
    "ConfigHistoryEntry",
    "ResponseEnvelope",
    "WorkspaceConfigRequest",
    "CreateProjectDraftRequest",
    "ApplyProjectConfigRequest",
    "DirectoryPickRequest",
    "RollbackProjectConfigRequest"
  ],
  "diagnostics": [
    "host-capability-probe",
    "lock-drift",
    "memory-audit",
    "memory-conflict",
    "memory-projection",
    "stage-timing",
    "host-version-probe",
    "scope-isolation"
  ],
  "client": {
    "platform": "web"
  },
  "entry": {
    "name": "@xiaobai/dsh-plugin",
    "inject": []
  }
}
