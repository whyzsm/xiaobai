# Build and Release Folders
bin-debug/
bin-release/
[Oo]bj/
[Bb]in/
dist/
node_modules/
coverage/
.DS_Store
npm-debug.log*

# Local workspace state
workspace/.local/
workspace/reports/simulations/
workspace/workspace.local.yaml
workspace/projects/*/.loop/local.paths.yaml

# Other files and folders
.settings/

# AI assistant local working memory (not project code — keep out of remotes)
.workbuddy/

# Local runtime data & deploy artifacts (agent state, .env, generated output — keep out of remotes)
.xiaobai-data/
deploy/

# AI tool local artifacts (agent working memory, generated screenshots — keep out of remotes)
.playwright-cli/
.understand-anything/
.dsh-vision-toolkit/
output/

# Plugin distribution archives (packaged build output — regenerate, do not commit)
*.zip

# Executables
*.swf
*.air
*.ipa
*.apk

# Project files, i.e. `.project`, `.actionScriptProperties` and `.flexProperties`
# should NOT be excluded as they contain compiler settings and other important
# information for Eclipse / Flash Builder.
